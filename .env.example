# Server
PORT=8787
HOST=127.0.0.1
TIMEZONE=Asia/Tokyo
DATABASE_PATH=./data/notifier.db
# Cloudflare版の管理画面専用パスワード（大学などのパスワードを再利用しない）
APP_PASSWORD=

# Science Tokyo LMS (Moodle)
# LMSの実URLと、Moodleウェブサービストークンを設定してください。
LMS_BASE_URL=
MOODLE_TOKEN=
# 推奨: LMSの「カレンダーをエクスポート」で生成した秘密URL。
# 設定されている場合はAPIトークンより優先されます。
MOODLE_ICAL_URL=
MOODLE_SYNC_DAYS=120

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# trueならLINEへ送らず、ターミナルに通知内容を表示します。
DRY_RUN=true

# 同期・通知チェック間隔（分）
SYNC_INTERVAL_MINUTES=30
NOTIFY_INTERVAL_MINUTES=1
